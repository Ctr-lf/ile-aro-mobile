{
  "expo": {
    "name": "Ilé Aró",
    "slug": "ile-aro-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ilearo",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FAF7F2",
    "ios": {
      "bundleIdentifier": "com.ctrlf.ilearo",
      "supportsTablet": true
    },
    "android": {
      "package": "com.ctrlf.ilearo",
      "adaptiveIcon": {
        "backgroundColor": "#F3ECE2",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF7F2",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "de45fb57-b63c-4a75-bcf0-a3bd63cd19dc"
      }
    },
    "owner": "ctrlf"
  }
}
